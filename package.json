{
  "name": "ddia-live-comic",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "DDIA, as a live comic — an unofficial illustrated companion to Designing Data-Intensive Applications",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/emit-routes.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "check:diagrams": "node scripts/check-diagrams.mjs",
    "test": "vitest run",
    "og": "node scripts/render-og.mjs"
  },
  "dependencies": {
    "@fontsource/comic-neue": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/newsreader": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "playwright-core": "^1.62.1",
    "typescript": "^5.5.4",
    "vite": "^5.4.0",
    "vitest": "^4.1.10"
  }
}
