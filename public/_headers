# Vite fingerprints every file under /assets with a content hash, so a changed
# file is always a changed URL. That makes them safe to cache forever, which
# Pages will not assume on its own.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# index.html must never be cached, or a deploy ships new hashed assets that
# returning readers never learn about.
/
  Cache-Control: public, max-age=0, must-revalidate
/index.html
  Cache-Control: public, max-age=0, must-revalidate
